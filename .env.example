# Telegram Bot Credentials
BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_ID=123456789

# API URLs
SCHEDULE_API_URL=https://timetable-ktmu.ru/api/storage/schedule-data-v2
YANDEX_DOC_PUBLIC_URL=https://disk.yandex.ru/i/your_yandex_disk_id

# Target Group Info
GROUP_ID=your_group_id
GROUP_NAME=your_group_name

# Timezone & Schedule Intervals
TIMEZONE=Europe/Moscow
DAILY_NOTIFY_HOUR=6
DAILY_NOTIFY_MINUTE=0
REMINDER_OFFSET_MINUTES=10
DOCX_CACHE_TTL_SECONDS=3600
SCHEDULE_CACHE_TTL_SECONDS=60

# Topic & Channel Config
TOPIC_CHAT_ID=-100XXXXXXXXXX
TOPIC_THREAD_ID=*******
EXAM_TOPIC_THREAD_ID=****
FLOOD_TOPIC_THREAD_ID=*
BIRTHDAY_TOPIC_THREAD_ID=****
IMPORTANT_TOPIC_THREAD_ID=*
ATTENDANCE_TOPIC_THREAD_ID=*****
EXAM_SCHEDULE_API_URL=*****************************

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=*****
REDIS_CACHE_TTL_SECONDS=600

# DeepSeek HW Solver Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-v4-flash-vision-exp
HW_INPUT_TOPIC_THREAD_ID=405
HW_OUTPUT_TOPIC_THREAD_ID=3951

# Internal API & gRPC Dual-Protocol Configuration
# Pre-shared secret key for internal HTTP/REST service authorization (X-API-Key)
API_SECRET_KEY=your_random_secret_api_key_here
# Internal REST gateway endpoint for services
API_BASE_URL=**********
# Interface binding address for the gRPC binary server
GRPC_HOST=******
# Port number for the internal gRPC binary server
GRPC_PORT=**********
# Network target address used by bot and workers to reach the gRPC service
GRPC_SERVER_ADDRESS=*************
# Maximum inbound message frame size for gRPC requests (default: 32MB)
GRPC_MAX_MESSAGE_LENGTH=33554432
# Public HTTPS URL of the Telegram Mini App (e.g., Cloudflare Tunnel endpoint)
MINIAPP_URL=https://your-tunnel-domain.trycloudflare.com
# Redis Set key used for storing Telegram IDs of authorized API testers
REDIS_TESTERS_KEY=api:testers:whitelist
# Lifetime of Mini App cryptographically signed session tokens in seconds (24h)
SESSION_MAX_AGE_SECONDS=******


# Attendance Tracker Configuration
DEPUTY_USER_ID=**************
ATTENDANCE_DOC_URL=https://docs.yandex.ru/docs/view?url=...
ATTENDANCE_SYNC_DAY_INTERVAL_SECONDS=180
ATTENDANCE_SYNC_NIGHT_INTERVAL_SECONDS=900
YANDEX_COOKIE=

