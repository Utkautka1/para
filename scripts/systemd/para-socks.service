[Unit]
Description=SOCKS5 proxy via VPS gateway vpn (127.0.0.1:1080) for tailscaled control plane
After=network-online.target
Wants=network-online.target

# На VPS — пользователь tunnel без shell: authorized_keys с restrict,port-forwarding и permitlisten
# только для 127.0.0.1:8080 и 127.0.0.1:2223. Ключ хоста VPS закреплён в /etc/ssh/ssh_known_hosts.
[Service]
Type=simple
User=root
# Провайдер рвёт long-poll Tailscale к controlplane.tailscale.com (DPI) — пускаем его через claude
ExecStart=/usr/bin/ssh -N -D 127.0.0.1:1080 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/ssh/ssh_known_hosts tunnel@185.230.67.217
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
